# Default engine: paddle (Bangla quality) or tesseract (fast CPU)
OCR_ENGINE=paddle

# --- Paddle ---
PADDLE_OCR_BACKEND=vl
PADDLE_OCR_DEVICE=cpu
PADDLE_OCR_FAST=1
PADDLE_OCR_USE_LAYOUT=0
PADDLE_OCR_MAX_SIDE=1280
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True

# --- Tesseract (fast) ---
# Install: download from https://github.com/UB-Mannheim/tesseract/wiki
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Bengali models can live in ./tessdata/ (ben.traineddata + eng.traineddata)
