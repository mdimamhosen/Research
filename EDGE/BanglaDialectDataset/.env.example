# Primary automated pipeline — open-source OCR
OCR_ENGINE=tesseract

# Windows Tesseract path (local only; not for Streamlit Cloud)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Optional cloud VLMs (not used by default)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=your-gemini-api-key
